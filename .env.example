# --- Mobile app (public, safe to ship; protected by Row Level Security) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side only: set with `supabase secrets set KEY=value` ---
# NEVER put these in the app or in this file in a committed repo.
# ANTHROPIC_API_KEY=sk-ant-...        (both AI assistants)
# AI_MODEL=claude-sonnet-5-5          (optional override)
# USDA_FDC_API_KEY=...                (free: https://fdc.nal.usda.gov/api-key-signup)
# SUPABASE_SERVICE_ROLE_KEY is injected automatically into Edge Functions.
